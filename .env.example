# backend-init 환경변수 템플릿 (cp .env.example .env 후 값 채우기)

# DB (PostgreSQL)
# 로컬 호스트 PostgreSQL 바인딩 포트 (선택, 기본값: 5432)
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/backend
DB_USERNAME=backend
DB_PASSWORD=backend

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT (게이트웨이 검증 / application 발급 공용 시크릿)
# 필수. 미설정 시 애플리케이션이 기동하지 않는다(fail-fast).
# UTF-8 기준 32바이트 이상의 무작위 값을 직접 생성해서 채울 것 — 아래 값을 그대로 쓰지 말 것.
# 생성 예: openssl rand -base64 48
JWT_SECRET=

# Gateway 기동 모드 (필수 허용값: embedded, standalone, remote / gateway/app application.yml 기본값: standalone)
GATEWAY_MODE=standalone

# Gateway 라우팅 대상 애플리케이션 URL (기본값: local 프로파일 시 http://localhost:8081, 비-local 환경 필수)
GATEWAY_APPLICATION_URL=http://localhost:8081

# Gateway 라우팅 대상 배치 서버 URL (기본값: local 프로파일 시 http://localhost:8082, 비-local 환경 필수)
GATEWAY_BATCH_URL=http://localhost:8082

# Gateway 라우팅 대상 다중 애플리케이션 URL 목록 (선택, 기본값: 없음, 쉼표 구분 시 내부 라운드로빈 활성화)
GATEWAY_APPLICATION_URLS=

# Gateway 최근 요청 모니터링(/internal/gateway/requests) 활성화 여부 (선택, 기본값: false)
GATEWAY_REQUEST_VISIBILITY_ENABLED=false

# Gateway 최근 요청 인메모리 이벤트 버퍼 보관 용량 (선택, 기본값: 200)
GATEWAY_REQUEST_VISIBILITY_CAPACITY=200

# 데모 인증 토큰 발급(POST /api/auth/token) 사용자명 (선택, 토큰 발급 기능 사용 시 필수)
DEMO_AUTH_USERNAME=

# 데모 인증 토큰 발급(POST /api/auth/token) 비밀번호 (선택, 토큰 발급 기능 사용 시 필수)
DEMO_AUTH_PASSWORD=
