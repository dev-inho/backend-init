# backend-init 환경변수 템플릿 (cp .env.example .env 후 값 채우기)

# DB (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/backend
DB_USERNAME=backend
DB_PASSWORD=backend

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT (게이트웨이 검증 / application 발급 공용 시크릿, 32바이트 이상)
JWT_SECRET=change-me-please-use-a-strong-32byte-min-secret-key-0123456789
